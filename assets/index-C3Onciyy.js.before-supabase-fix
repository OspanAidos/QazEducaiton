t>"u"?null:vh.createPortal(gl,document.body)}function G0({t:y,lang:z,onLangChange:T}){const m=[{code:"ru",label:"RU"},{code:"kk",label:"ҚАЗ"}];return h.jsx("div",{className:"flex shrink-0 items-center rounded-full border border-line",role:"group","aria-label":y.a11y.langSwitch,children:m.map(E=>{const B=z===E.code;return h.jsx("button",{type:"button","aria-pressed":B,onClick:()=>T(E.code),className:`flex h-11 min-w-[38px] items-center justify-center rounded-full px-1.5 text-xs font-medium transition-colors duration-300 sm:min-w-[44px] sm:px-2 ${B?"bg-ink text-bg":"text-muted hover:text-ink"}`,children:E.label},E.code)})})}const Jh=["oferta","programma","otbor","metodika","soglasie"],U0={oferta:{path:"/docs/oferta",short:"Публичная оферта",title:"Публичная оферта",body:["ПУБЛИЧНАЯ ОФЕРТА НА УЧАСТИЕ В ЕЖЕГОДНОЙ ОБРАЗОВАТЕЛЬНОЙ И СТИПЕНДИАЛЬНОЙ ПРОГРАММЕ QazEducation","Редакция от 21 августа 2026 года.","1. ОБЩИЕ ПОЛОЖЕНИЯ","Настоящая Публичная оферта является официальным предложением ТОО «Business International Group Partners» заключить договор на участие в ежегодной образовательной и стипендиальной программе QazEducation на условиях, изложенных в настоящем документе.","Оферта разработана с учетом положений Гражданского кодекса Республики Казахстан, законодательства об образовании, благотворительности, персональных данных и защите прав потребителей.","Акцептом Оферты признается совершение Участником совокупности действий: регистрация на платформе, проставление обязательной отметки о принятии условий Оферты и внесение организационного платежа в размере 10 000 тенге через доступный на платформе способ оплаты.","Программа QazEducation является частной ежегодной образовательной и стипендиальной программой поддержки молодежи Республики Казахстан и не относится к государственным образовательным грантам или государственным стипендиям.","2. ТЕРМИНЫ И ОПРЕДЕЛЕНИЯ","Организатор – ТОО «Business International Group Partners». Программа – ежегодная образовательная и стипендиальная программа QazEducation. Участник – лицо в возрасте от 14 до 25 лет включительно, подавшее заявку и оплатившее организационный платеж.","Образовательный грант – целевая финансовая поддержка победителя для оплаты обучения. Стипендия – ежемесячная финансовая поддержка победителя конкурса. Кадровый резерв – список Top-30 перспективных финалистов Программы.","3. ПРЕДМЕТ ДОГОВОРА","Организатор обеспечивает Участнику возможность участия в Программе, регистрацию заявки, администрирование документов, участие в конкурсном отборе, доступ к информационным и образовательным материалам при их наличии, а также выдачу сертификата участника.","Организационный платеж не является оплатой образовательного гранта или стипендии и не предоставляет преимущества перед другими участниками.","4. УСЛОВИЯ УЧАСТИЯ","Участниками могут быть лица в возрасте от 14 до 25 лет включительно: выпускники 9 и 11 классов, учащиеся колледжей и студенты университетов, включая бакалавриат и магистратуру. В конкурсном цикле 2026 года допускаются граждане Республики Казахстан и иностранные участники, планирующие обучение в Казахстане.","Образовательные гранты по настоящей Программе не предоставляются на медицинские и ветеринарные образовательные программы.","Для несовершеннолетних участников акцепт Оферты осуществляется законным представителем либо с его письменного согласия.","5. ОПЛАТА И ВОЗВРАТ","Оплата производится через платежный способ, фактически доступный на платформе. Подтверждением оплаты является статус платежа, полученный платформой от платежного сервиса.","Заявление о возврате рассматривается с учетом объема фактически оказанных услуг, условий настоящей Оферты и императивных требований законодательства Республики Казахстан о защите прав потребителей. Настоящая Оферта не ограничивает права, которые не могут быть ограничены соглашением сторон.","При добровольном отказе Участника Организатор вправе удержать документально подтвержденную стоимость фактически оказанных к моменту отказа услуг в пределах, допускаемых законодательством Республики Казахстан.","6. ОТСУТСТВИЕ ГАРАНТИЙ","Оплата организационного платежа не гарантирует получение образовательного гранта, стипендии, прохождение в полуфинал или финал, включение в кадровый резерв либо получение иных преимуществ.","Победители определяются исключительно по итогам конкурсного отбора на основании утвержденных критериев оценки.","7. ПЕРСОНАЛЬНЫЕ ДАННЫЕ И ЗАКЛЮЧИТЕЛЬНЫЕ ПОЛОЖЕНИЯ","Совершая акцепт Оферты, Участник дает согласие на сбор, обработку, хранение и использование персональных данных для целей организации и проведения Программы.","Организатор вправе изменять настоящую Оферту путем публикации новой редакции на официальных ресурсах Программы.","Все споры разрешаются путем переговоров, а при недостижении соглашения – в порядке, предусмотренном законодательством Республики Казахстан."]},programma:{path:"/docs/programma",short:"Положение о программе",title:"Положение о программе",body:["УТВЕРЖДЕНО","Решением ТОО «Business International Group Partners»","№ ____ от «___» __________ 20___ года","ПОЛОЖЕНИЕ О ЕЖЕГОДНОЙ ОБРАЗОВАТЕЛЬНОЙ И СТИПЕНДИАЛЬНОЙ ПРОГРАММЕ QAZEDUCATION","Редакция для конкурсного цикла 2026 года от 21 августа 2026 года.","1. ОБЩИЕ ПОЛОЖЕНИЯ","Настоящее Положение определяет цели, задачи, принципы, организационную структуру, порядок реализации, финансирования и развития ежегодной образовательной и стипендиальной программы QazEducation.","Программа является частной образовательной и социальной инициативой ТОО «Business International Group Partners», направленной на поддержку талантливой, активной и мотивированной молодежи Республики Казахстан.","Программа реализуется ежегодно на территории Республики Казахстан и не является государственной программой, государственным образовательным грантом или государственной стипендией.","2. МИССИЯ, ЦЕЛЬ И ЗАДАЧИ","Миссией Программы является создание устойчивой системы поддержки молодежи Республики Казахстан путем расширения доступа к образованию, развития человеческого капитала и формирования будущего кадрового потенциала страны.","Целью Программы является предоставление на конкурсной основе образовательных грантов и стипендий обучающимся и выпускникам организаций образования Республики Казахстан.","– повышение доступности качественного образования","– поддержка талантливой и мотивированной молодежи","– поддержка молодежи из социально уязвимых категорий","– стимулирование академической, социальной, научной, творческой и общественной активности","– формирование кадрового резерва перспективных молодых специалистов","3. УЧАСТНИКИ ПРОГРАММЫ","Участниками Программы могут быть лица в возрасте от 14 до 25 лет включительно. В цикле 2026 года участвуют граждане Республики Казахстан и иностранные участники, планирующие обучение в Казахстане.","Право на участие имеют выпускники 9 и 11 классов, учащиеся колледжей, студенты организаций высшего образования по программам бакалавриата и магистратуры. Обучающиеся в докторантуре в Программе не участвуют.","4. ВИДЫ ПОДДЕРЖКИ","В рамках Программы предоставляются образовательные гранты, ежемесячные стипендии, участие в кадровом резерве Top-30, образовательные мероприятия, консультационная и информационная поддержка.","В конкурсном цикле 2026 года предусмотрены 10 образовательных грантов и 30 ежемесячных стипендий. Размер стипендии составляет 50 000 тенге в месяц.","Образовательные гранты не распространяются на медицинские и ветеринарные образовательные программы. Размер и порядок оплаты каждого образовательного гранта определяются договором с победителем и организацией образования.","5. ОРГАНЫ УПРАВЛЕНИЯ","Управление Программой осуществляется Организатором, Попечительским советом, Конкурсной комиссией и Секретариатом Программы.","Попечительский совет является консультативно-наблюдательным органом. Конкурсная комиссия осуществляет оценку заявок и формирует рекомендации по определению победителей. Секретариат обеспечивает прием заявок, проверку документов и организационное сопровождение.","6. КОНКУРСНЫЙ ОТБОР","Предоставление образовательных грантов и стипендий осуществляется на конкурсной основе в соответствии с Положением о конкурсном отборе и Методикой оценки участников.","Все критерии, сроки, перечень документов, порядок подачи заявок, основания отказа и апелляционная процедура публикуются до начала приема заявок.","7. КАДРОВЫЙ РЕЗЕРВ","Кадровый резерв QazEducation Top-30 формируется из 30 участников с наивысшим рейтингом среди оцененных финалистов, не получивших образовательный грант или стипендию. Включение в кадровый резерв не является денежной формой поддержки и не гарантирует трудоустройство.","8. ФИНАНСИРОВАНИЕ И МОНИТОРИНГ","Финансирование Программы осуществляется за счет собственных средств Организатора, организационных платежей участников, средств партнеров, спонсоров, меценатов и иных источников, не запрещенных законодательством Республики Казахстан.","Победители подлежат мониторингу в течение периода получения поддержки. Непредоставление документов, недостоверные сведения, прекращение обучения или нарушение условий соглашений являются основанием для приостановления либо прекращения поддержки.","9. ПЕРСОНАЛЬНЫЕ ДАННЫЕ, КОНФЛИКТ ИНТЕРЕСОВ И ОТЧЕТНОСТЬ","Сбор и обработка персональных данных осуществляются на основании согласия участника или его законного представителя.","Члены Попечительского совета, Конкурсной комиссии, эксперты и сотрудники Секретариата обязаны соблюдать требования по предотвращению конфликта интересов.","Ключевые решения по Программе оформляются протоколами, а общая информация о реализации Программы может публиковаться Организатором."]},otbor:{path:"/docs/otbor",short:"Положение о конкурсном отборе",title:"Положение о конкурсном отборе",body:["УТВЕРЖДЕНО","Решением ТОО «Business International Group Partners»","№ ____ от «___» __________ 20___ года","ПОЛОЖЕНИЕ О КОНКУРСНОМ ОТБОРЕ УЧАСТНИКОВ ЕЖЕГОДНОЙ ОБРАЗОВАТЕЛЬНОЙ И СТИПЕНДИАЛЬНОЙ ПРОГРАММЫ QAZEDUCATION","Редакция для конкурсного цикла 2026 года от 21 августа 2026 года.","1. ОБЩИЕ ПОЛОЖЕНИЯ","Настоящее Положение определяет порядок организации и проведения конкурсного отбора участников Программы QazEducation.","Конкурс проводится ежегодно на территории Республики Казахстан в целях выявления наиболее перспективных, мотивированных и достойных кандидатов для получения образовательных грантов, стипендий и включения в кадровый резерв.","2. КАТЕГОРИИ ПОДДЕРЖКИ","В рамках конкурсного отбора могут предоставляться образовательные гранты QazEducation, стипендии QazEducation и включение в кадровый резерв Top-30.","В конкурсном цикле 2026 года предусмотрены 10 образовательных грантов, 30 стипендий и 30 мест в кадровом резерве Top-30.","3. ТРЕБОВАНИЯ К УЧАСТНИКАМ","К участию в цикле 2026 года допускаются граждане Республики Казахстан и иностранные участники в возрасте от 14 до 25 лет включительно: выпускники 9 и 11 классов, учащиеся колледжей и студенты университетов, включая бакалавриат и магистратуру. Медицинские и ветеринарные образовательные программы не участвуют в грантовом треке.","Один участник вправе подать одну заявку в рамках одного конкурсного цикла, если иное не установлено Организатором.","4. ПОДАЧА ЗАЯВОК","Для конкурсного цикла 2026 года регистрация и подача заявок проводятся с 10 августа 2026 года 00:00 до 30 сентября 2026 года 23:59 по времени Астаны включительно.","Участник регистрируется на официальной платформе Программы, заполняет заявку, предоставляет документы, отдельно подтверждает согласие на обработку персональных данных и принятие документов Программы, а затем оплачивает организационный платеж 10 000 тенге через доступный на платформе способ оплаты.","Несовершеннолетний участник предоставляет свидетельство о рождении, документ законного представителя и его письменное согласие.","Ответственность за полноту и достоверность сведений несет участник.","5. ЭТАПЫ КОНКУРСНОГО ОТБОРА","– публикация объявления о начале конкурса","– прием заявок","– техническая проверка документов","– балльная оценка заявок","– передача допущенных заявок независимым членам комиссии","– оценка по опубликованным критериям","– определение победителей","– формирование кадрового резерва Top-30 из оставшихся оцененных финалистов","6. ТЕХНИЧЕСКАЯ ПРОВЕРКА И ОЦЕНКА","На этапе технической проверки оценивается комплектность документов, возраст, статус обучающегося, соблюдение сроков, наличие оплаты и отсутствие дублирующих заявок.","Оценка участников проводится по 100-балльной системе на основании Методики оценки. Конкретные критерии могут отличаться для грантового и стипендиального треков.","7. АПЕЛЛЯЦИЯ И ПУБЛИКАЦИЯ РЕЗУЛЬТАТОВ","Участник вправе подать апелляцию только по вопросам соблюдения процедуры конкурса в течение 3 рабочих дней с даты публикации результатов соответствующего этапа.","Апелляция не является инструментом повторной экспертной оценки заявки. Результаты конкурса публикуются на официальных ресурсах Программы в пределах согласия на обработку и распространение персональных данных."]},metodika:{path:"/docs/metodika",short:"Методика оценки участников",title:"Методика оценки участников",body:["УТВЕРЖДЕНО","Решением ТОО «Business International Group Partners»","№ ____ от «___» __________ 20___ года","МЕТОДИКА ОЦЕНКИ УЧАСТНИКОВ ЕЖЕГОДНОЙ ОБРАЗОВАТЕЛЬНОЙ И СТИПЕНДИАЛЬНОЙ ПРОГРАММЫ QAZEDUCATION","Редакция для конкурсного цикла 2026 года от 21 августа 2026 года.","1. ОБЩИЕ ПОЛОЖЕНИЯ","Настоящая Методика определяет порядок оценки участников, критерии начисления баллов, порядок формирования рейтинга и определения победителей конкурсного отбора.","Максимальный итоговый результат составляет 100 баллов. Для различных видов поддержки применяются отдельные критерии оценки.","2. ОЦЕНКА ПРЕТЕНДЕНТОВ НА ОБРАЗОВАТЕЛЬНЫЙ ГРАНТ","Академическая успеваемость — от 0 до 25 баллов. Мотивация и образовательные цели — от 0 до 30 баллов. Личные достижения — от 0 до 20 баллов. Социальная активность и лидерство — от 0 до 10 баллов. Социальное положение и потребность в поддержке — от 0 до 15 баллов.","3. ОЦЕНКА ПРЕТЕНДЕНТОВ НА СТИПЕНДИЮ","Социальное положение и потребность в поддержке — от 0 до 30 баллов. Академическая успеваемость — от 0 до 20 баллов. Мотивация — от 0 до 25 баллов. Социальная активность — от 0 до 15 баллов. Личные достижения — от 0 до 10 баллов.","Каждый активный член комиссии оценивает заявку независимо. Эксперт не видит оценки других экспертов до завершения собственной оценки. Итоговый балл равен среднему арифметическому завершенных оценок всех активных членов комиссии.","4. ФОРМИРОВАНИЕ РЕЙТИНГА","По итогам оценки формируется рейтинг участников соответствующей категории в порядке убывания итогового количества баллов. Победителями признаются участники, занявшие наиболее высокие позиции в рейтинге.","При равенстве итоговых баллов по образовательным грантам преимущество получает участник с более высоким средним баллом по критерию «Мотивация и образовательные цели». По стипендиям — по критерию «Социальное положение и потребность в поддержке». Если равенство сохраняется на границе квоты и после дополнительного критерия, автоматическая публикация блокируется до оформления решения комиссии.","Top-30 формируется среди оставшихся оцененных финалистов после распределения 10 грантов и 30 стипендий. При полном равенстве итогового и дополнительного баллов на границе Top-30 автоматическая публикация также блокируется.","5. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА","Организатор вправе проводить дополнительную проверку представленных сведений. При выявлении недостоверной информации результаты участника подлежат аннулированию независимо от этапа конкурса."]},soglasie:{path:"/docs/soglasie",short:"Согласие на обработку персональных данных",title:"Согласие на обработку персональных данных",body:["СОГЛАСИЕ НА СБОР, ОБРАБОТКУ, ХРАНЕНИЕ, ИСПОЛЬЗОВАНИЕ И РАСПРОСТРАНЕНИЕ ПЕРСОНАЛЬНЫХ ДАННЫХ","Редакция от 21 августа 2026 года.","1. СОГЛАСИЕ УЧАСТНИКА","Я, ______________________________________________________________, ИИН ____________________________, настоящим даю согласие ТОО «Business International Group Partners» на сбор, обработку, хранение, использование и систематизацию моих персональных данных в целях участия в программе QazEducation.","2. СОСТАВ ПЕРСОНАЛЬНЫХ ДАННЫХ","– фамилия, имя, отчество","– дата рождения и ИИН","– контактные данные и адрес проживания","– сведения об образовании и успеваемости","– сведения о достижениях","– сведения о социальном положении","– документы, подтверждающие статус участника","– фото-, видео- и иные материалы, предоставленные участником","3. ЦЕЛИ ОБРАБОТКИ","Персональные данные обрабатываются для регистрации участника, проверки документов, проведения конкурсного отбора, оценки заявки, формирования рейтинга, подведения итогов, заключения договоров с победителями, мониторинга и выдачи сертификатов.","Срок обработки ограничивается периодом, необходимым для достижения указанных целей и исполнения обязательных требований законодательства. По достижении целей данные подлежат уничтожению либо обезличиванию, если их дальнейшее хранение не требуется по закону.","4. ПУБЛИКАЦИЯ СВЕДЕНИЙ","По умолчанию публичный список результатов содержит только номер заявки и присвоенный статус. Публикация Ф.И.О., изображения, города, организации образования или иных дополнительных сведений допускается только на основании отдельного, конкретного согласия участника или его законного представителя.","ИИН, адрес проживания, номер телефона, сведения о доходах семьи, медицинские данные и иные сведения ограниченного доступа без отдельного согласия не публикуются.","5. НЕСОВЕРШЕННОЛЕТНИЙ УЧАСТНИК","Я, ______________________________________________________________, являясь законным представителем несовершеннолетнего участника ______________________________________________________________, даю согласие на сбор, обработку, хранение, использование и распространение его персональных данных в целях участия в программе QazEducation.","Подпись участника: ____________________","Подпись законного представителя: ____________________  Дата: ________________"]}};function wh({t:y}){const