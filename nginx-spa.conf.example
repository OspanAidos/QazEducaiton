location / {
  try_files $uri $uri/ /index.html;
}

location /assets/ {
  expires 1y;
  add_header Cache-Control "public, max-age=31536000, immutable";
  try_files $uri =404;
}

location ~* \\.(?:png|jpe?g|webp|svg)$ {
  expires 7d;
  add_header Cache-Control "public, max-age=604800";
  try_files $uri =404;
}
